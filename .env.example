# =============================================================================
# Cosimo — Local Edition (no API keys, nothing phones home)
# =============================================================================

# --- Knowledge base ---
COLLECTION_PATH=data/collection_optimized.json

# --- Wake word (Phase D) ---
WAKE_WORD_MODEL=hey_cosimo.onnx
WAKE_THRESHOLD=0.5          # raise if it triggers on its own, lower if it misses you
WAKE_LOG_SCORES=false       # true while tuning in the gallery

# --- Speech-to-text: Voxtral Realtime via mlx-audio (Apache 2.0) ---
STT_MODEL=mistralai/Voxtral-Mini-4B-Realtime-2602   # exact MLX repo confirmed in Phase C
STT_LANGUAGE=en

# --- LLM via MLX (or Ollama) ---
LLM_BACKEND=mlx             # mlx | ollama
LLM_MODEL=                  # chosen in Phase C by latency test
LLM_MAX_TOKENS=200

# --- Text-to-speech: Kokoro-82M via mlx-audio (Apache 2.0) ---
TTS_MODEL=prince-canuma/Kokoro-82M
TTS_VOICE=am_michael        # Kokoro male US voice; try bm_george for British

# --- Turn taking ---
VAD_STOP_SECS=0.7           # silence that ends a visitor's turn (600–800 ms)
MAX_SILENT_TURNS=3          # end session after this many unanswered turns

# --- Logs ---
LOG_DIR=logs