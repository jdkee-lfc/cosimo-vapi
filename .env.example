# =============================================================================
# Cosimo — Vapi Cloud Edition
# Copy to .env and fill in your values
# =============================================================================

# Vapi API keys — get these at https://dashboard.vapi.ai/
VAPI_API_KEY=your_vapi_private_api_key_here
VAPI_PUBLIC_KEY=your_vapi_public_key_here

# Wake word — built-in options: hey_jarvis, alexa, hey_mycroft, hey_rhasspy
# (uses OpenWakeWord, no account needed)
WAKE_WORD=hey_jarvis

# Custom wake word model (optional) — path to your trained .onnx file
# Train your own at: https://github.com/dscripka/openWakeWord/blob/main/notebooks/training_models.ipynb
# WAKE_WORD_MODEL=data/hey_cosimo.onnx

# Created by cosimo-setup (don't edit manually)
VAPI_ASSISTANT_ID=
